{
  "$comment": "Modified for pinecone desktop; see NOTICE.",
  "name": "@pinecone/repo",
  "version": "0.0.0",
  "description": "pinecone Monorepo",
  "homepage": "https://github.com/Carey8175/pinecone",
  "license": "Apache-2.0",
  "private": true,
  "author": {
    "name": "Carey8175",
    "url": "https://github.com/Carey8175"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "build:foundation": "bun --filter @pinecone/foundation build",
    "build:cli": "bun build:foundation && bun --filter pinecone typecheck && bun --filter pinecone build",
    "build:studio": "bun build:foundation && bun --filter @pinecone/studio build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "bun --filter '*' clean",
    "db:gen": "bun --filter @pinecone/supabase db:gen",
    "db:gen:local": "bun --filter @pinecone/backend db:gen",
    "dev:foundation": "bun --filter @pinecone/foundation dev",
    "dev:studio": "bun --filter @pinecone/studio dev",
    "build": "bun --filter '*' build",
    "ci:build": "bun run build:foundation && bun --filter '*' build",
    "dev": "bun --elide-lines=0  --filter '*' dev",
    "test": "bun --filter '*' test",
    "format": "bun --filter '*' format",
    "lint": "bun --filter @pinecone/studio lint",
    "typecheck": "bun --filter '*' typecheck",
    "increment_tag": "./scripts/increment_tag.sh",
    "publish_tag": "./scripts/publish_tag.sh",
    "remove_tag": "./scripts/remove_tag.sh",
    "download_bun": "bun run ./scripts/download_bun.ts",
    "prepare": "husky",
    "desktop": "bun run prepare:resources && bun run build:studio && bun run rebuild:native && bun --filter @pinecone/studio start",
    "start": "bun --filter @pinecone/studio start",
    "rebuild:native": "bun scripts/rebuild_native.ts",
    "prepare:resources": "bun scripts/prepare_resources.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carey8175/pinecone.git"
  },
  "bugs": {
    "url": "https://github.com/Carey8175/pinecone/issues"
  },
  "devDependencies": {
    "extract-zip": "^2.0.1",
    "husky": "^9.1.6",
    "@electron/rebuild": "3.7.0"
  },
  "packageManager": "bun@1.3.12",
  "overrides": {
    "node-abi": "3.101.0"
  }
}
