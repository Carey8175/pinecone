{
  "$comment": "Modified for pinecone; see NOTICE.",
  "name": "@pinecone/repo",
  "version": "0.0.0",
  "description": "pinecone Monorepo",
  "homepage": "https://github.com/Carey8175/pinecone",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Carey8175",
    "url": "https://github.com/Carey8175"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*",
    "apps/web/*",
    "docs"
  ],
  "scripts": {
    "build": "bun --filter @pinecone/web build:client",
    "start": "bun --filter @pinecone/web start:client",
    "dev": "bun --filter @pinecone/web dev",
    "test": "bun --filter '*' test",
    "docs": "bun --filter @pinecone/docs dev",
    "backend:start": "bun --filter @pinecone/backend start",
    "db:gen": "bun --filter @pinecone/db db:gen",
    "db:push": "cd packages/db && bun db:push",
    "db:seed": "cd packages/db && bun db:seed",
    "db:migrate": "cd packages/db && bun db:migrate",
    "db:reset": "cd apps/backend && bun run reset",
    "format": "bun --filter '*' format",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter @pinecone/web-client typecheck",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "bun --filter '*' clean",
    "setup:env": "cd packages/scripts && bun run start",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose down && docker compose up -d --build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carey8175/pinecone.git"
  },
  "bugs": {
    "url": "https://github.com/Carey8175/pinecone/issues"
  },
  "devDependencies": {
    "@pinecone/eslint": "*"
  },
  "packageManager": "bun@1.3.1"
}
