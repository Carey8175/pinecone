  "homepage": "https://github.com/Carey8175/pinecone",
  "devDependencies": {
    "@pinecone/eslint": "*",
    "eslint": "^9.0.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "stripe": "^18.2.1",
    "dotenv": "^16.5.0",
    "@pinecone/models": "*"
  }
}
